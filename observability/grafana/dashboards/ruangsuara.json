        "type": "prometheus",
        "uid": "ruangsuara-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(ruangsuara_migration_completions_total{outcome=\"failed\"}[$__rate_interval])) or on() (0 * sum(rate(ruangsuara_migration_completions_total[$__rate_interval])))) / sum(rate(ruangsuara_migration_completions_total[$__rate_interval]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "ruangsuara-prometheus"
          },
          "range": false,
          "instant": true
