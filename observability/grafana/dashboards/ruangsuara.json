        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Collection health",
      "description": "1 means healthy. A failed state query omits both status families. An unreachable backend also makes the state collection series disappear.",
      "datasource": {
        "type": "prometheus",
        "uid": "ruangsuara-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"ruangsuara\"})",
          "legendFormat": "Scrape",
          "datasource": {
            "type": "prometheus",
            "uid": "ruangsuara-prometheus"
          },
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "expr": "min(ruangsuara_state_collection_success)",
          "legendFormat": "Database state",
          "datasource": {
            "type": "prometheus",
            "uid": "ruangsuara-prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
