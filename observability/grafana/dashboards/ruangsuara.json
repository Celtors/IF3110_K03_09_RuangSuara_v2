        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ruangsuara_change_requests{status=\"queued\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "ruangsuara-prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
