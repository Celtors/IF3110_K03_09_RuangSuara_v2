          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.5, sum by (le) (rate(ruangsuara_http_request_duration_seconds_bucket[$__rate_interval])))",
              "legendFormat": "p50",
              "datasource": {
                "type": "prometheus",
                "uid": "ruangsuara-prometheus"
              },
              "range": true,
              "instant": false
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by (le) (rate(ruangsuara_http_request_duration_seconds_bucket[$__rate_interval])))",
              "legendFormat": "p95",
              "datasource": {
                "type": "prometheus",
                "uid": "ruangsuara-prometheus"
              },
              "range": true,
              "instant": false
            }
